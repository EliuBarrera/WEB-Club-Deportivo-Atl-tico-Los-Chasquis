# Copia este archivo a .env y completa los valores reales.
# Ver .env para el comentario sobre por qué Prisma necesita `dotenv/config`
# explícito (prisma.config.ts) en vez de cargar `.env` automáticamente.

DATABASE_URL=

# CLOUDINARY - ALMACENAMIENTO DE IMAGENES
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CLOUDFLARE - CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WOMPI
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# AUTH.JS (Fase 6 - panel de administrador)
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# BREVO - WHATSAPP BUSINESS API (Fase 11 - difusión y notificación de pago)
BREVO_API_KEY=
BREVO_WHATSAPP_TEMPLATE_ID_RESUMEN=
BREVO_WHATSAPP_TEMPLATE_ID_PAGO=

# RESEND - CORREO TRANSACCIONAL (Fase 11)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# URL PUBLICA DEL SITIO (enlaces en WhatsApp/correo, Fase 11)
NEXT_PUBLIC_SITE_URL=

// ==========================================
// Club Los Chasquis - Modelo de datos
// PostgreSQL + Prisma
// ==========================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum EstadoEvento {
  ABIERTO
  CERRADO
  BORRADOR
}

enum Genero {
  MASCULINO
  FEMENINO
}

enum TipoDocumento {
  RC
  TI
  CC
  CE
  PA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  DECLINADO
  ERROR
}

enum RolUsuario {
  ADMIN
  EDITOR
}

// Fase 12.3: PISTA = festivales donde cada categoría elige pruebas del
// catálogo; CALLE = carreras donde cada categoría corre una distancia fija
// con su propia hora y sitio de salida.
enum TipoEvento {
  PISTA
  CALLE
}

// ==========================================
// USUARIOS DEL PANEL ADMIN
// ==========================================

model Usuario {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  nombre        String
  rol           RolUsuario    @default(EDITOR)
  createdAt     DateTime      @default(now())
  enviosMasivos EnvioMasivo[]
}

// ==========================================
// CATÁLOGO GLOBAL DE PRUEBAS
// (equivalente a PRUEBAS_CATALOGO en CalendarEvents.js)
// ==========================================

model PruebaCatalogo {
  id     String  @id @default(cuid())
  key    String  @unique // ej: "100_m", "salto_largo"
  nombre String // ej: "100 m planos"
  icon   String? // emoji o nombre de icono
  genero Genero? // null = aplica a ambos

  categorias CategoriaPrueba[]
}

// ==========================================
// EVENTO (tabla central)
// ==========================================

model Evento {
  id                   String       @id @default(cuid())
  titulo               String
  subtitulo            String?
  lema                 String?
  precio               Int
  descuento            Int          @default(0)
  descuentoLabel       String? // ej: "Pagando antes del 20 de febrero"
  fechaLimiteDescuento DateTime?
  estado               EstadoEvento @default(BORRADOR)
  tipo                 TipoEvento   @default(PISTA)
  fecha                DateTime
  horario              String? // texto libre, ej: "7:00 AM - 5:00 PM"
  ubicacion            String
  mapUrl               String?
  descripcion          String?      @db.Text
  imagenUrl            String?
  resultadosUrl        String?
  terminosUrl          String?
  cierreInscripciones  String? // texto libre, ej: "10 de abril de 2026"
  aval                 String?
  organizador          String?
  lemaInstitucional    String?

  // Relaciones 1:1
  premios    Premios?
  reglamento Reglamento?
  logistica  Logistica?

  // Relaciones 1:N
  recorridos    Recorrido[]
  distancias    Distancia[]
  categorias    Categoria[]
  noticias      Noticia[]
  objetivos     Objetivo[]
  convocatoria  ConvocatoriaItem[]
  costos        Costo[]
  inscripciones Inscripcion[]
  enviosMasivos EnvioMasivo[]
  rondas        RondaInscripcion[]
  gruposTarifa  GrupoTarifa[]

  // Integración pagos / e-commerce (si se mantiene puente con WooCommerce en transición)
  wompiProductRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([estado])
}

// Auditoría de la difusión masiva por WhatsApp/Correo (Fase 11): un admin
// dispara un envío a todos los atletas únicos del club (ver
// lib/admin/atletas.ts) desde la ficha de un evento. Solo guarda conteos
// agregados y una muestra acotada de errores — nunca cuerpos de mensaje ni
// datos de contacto nuevos (numeroDocumento ya es un identificador interno
// usado en toda la app).
enum CanalEnvioMasivo {
  WHATSAPP
  EMAIL
}

model EnvioMasivo {
  id                 String           @id @default(cuid())
  eventoId           String
  evento             Evento           @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  canal              CanalEnvioMasivo
  usuarioId          String
  usuario            Usuario          @relation(fields: [usuarioId], references: [id])
  totalDestinatarios Int
  totalExitosos      Int
  totalFallidos      Int
  erroresMuestra     Json? // hasta 20 { numeroDocumento, motivo }
  createdAt          DateTime         @default(now())

  @@index([eventoId])
}

// ==========================================
// CATEGORÍAS Y PRUEBAS POR CATEGORÍA
// ==========================================

model Categoria {
  id       String @id @default(cuid())
  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  nombre     String // ej: "SUB 14", "MAYORES"
  edad       String // ej: "12-13 años"
  nacimiento String // ej: "2014-2013"
  rama       String @default("MASCULINA Y FEMENINA")
  orden      Int    @default(0)

  // Grupo de tarifa al que pertenece (ej. "adultos"/"menores"); define su
  // precio en cada ronda. Null mientras el evento no use rondas.
  grupoTarifaId String?
  grupoTarifa   GrupoTarifa? @relation(fields: [grupoTarifaId], references: [id], onDelete: SetNull)

  // Distancia que recorre la categoría, elegida de las del evento. Sirve
  // en cualquier tipo de evento; null = sin distancia definida.
  distanciaId String?
  distancia   Distancia? @relation(fields: [distanciaId], references: [id], onDelete: SetNull)

  // Carreras de calle (Fase 12.3): qué recorrido corre la categoría y con
  // qué hora/sitio. Null en festivales de pista.
  recorridoId  String?
  recorrido    Recorrido? @relation(fields: [recorridoId], references: [id], onDelete: SetNull)
  vueltas      Int?
  horaSalida   String? // ej: "8:00 a.m."
  sitioSalida  String?
  sitioLlegada String?

  pruebas       CategoriaPrueba[]
  inscripciones Inscripcion[]

  @@index([eventoId])
  @@index([grupoTarifaId])
  @@index([distanciaId])
}

// Distancias del evento (ej. "10 km", "800 m"), creadas en el admin y
// asignadas a cada categoría. Se ordenan solas por metros (lib/distancias.ts).
model Distancia {
  id       String @id @default(cuid())
  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nombre   String

  categorias Categoria[]

  @@unique([eventoId, nombre])
}

// ==========================================
// PRECIOS POR RONDAS (Fase 12.1)
// ==========================================

// El precio vigente se resuelve en servidor: la primera ronda (por `orden`)
// cuya `fechaCierre` no haya pasado, y dentro de ella la tarifa del grupo de
// la categoría elegida. Sin ronda vigente, las inscripciones están cerradas.
// Un "descuento por pronto pago" es solo una ronda 1 más barata que la 2.
model RondaInscripcion {
  id          String   @id @default(cuid())
  eventoId    String
  evento      Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  orden       Int
  nombre      String // ej: "I Ronda"
  fechaCierre DateTime

  tarifas       TarifaInscripcion[]
  inscripciones Inscripcion[]

  @@unique([eventoId, orden])
}

model GrupoTarifa {
  id       String   @id @default(cuid())
  eventoId String
  evento   Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nombre   String // ej: "adultos", "menores"
  // Lo que incluye la inscripción para este grupo (ej. "camiseta", "chip").
  derechos String[]
  orden    Int      @default(0)

  categorias    Categoria[]
  tarifas       TarifaInscripcion[]
  inscripciones Inscripcion[]

  @@unique([eventoId, nombre])
}

model TarifaInscripcion {
  id            String           @id @default(cuid())
  rondaId       String
  ronda         RondaInscripcion @relation(fields: [rondaId], references: [id], onDelete: Cascade)
  grupoTarifaId String
  grupoTarifa   GrupoTarifa      @relation(fields: [grupoTarifaId], references: [id], onDelete: Cascade)
  // 0 = inscripción gratuita: no pasa por Wompi (Fase 12.2).
  valor         Int

  @@unique([rondaId, grupoTarifaId])
}

// Tabla puente: qué pruebas del catálogo aplican a cada categoría de cada evento
model CategoriaPrueba {
  id          String         @id @default(cuid())
  categoriaId String
  categoria   Categoria      @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  pruebaId    String
  prueba      PruebaCatalogo @relation(fields: [pruebaId], references: [id])

  @@unique([categoriaId, pruebaId])
}

// ==========================================
// RECORRIDO
// ==========================================

// Un evento puede tener varios recorridos (Fase 12.3: ej. 10K, 8K/4K,
// 1.5K, 1K en una carrera de calle), cada uno con las categorías que lo
// corren. Los festivales de pista siguen teniendo uno o ninguno.
model Recorrido {
  id       String  @id @default(cuid())
  eventoId String
  evento   Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nombre   String? // ej: "Recorrido 10K"
  orden    Int     @default(0)

  mapaUrl   String?
  distancia String? // ej: "6 kilómetros"
  desnivel  String? // ej: "+250 metros"
  salida    String?
  meta      String?
  modalidad String?
  terreno   String?

  programacion ImagenProgramacion[]
  categorias   Categoria[]

  @@index([eventoId])
}

model ImagenProgramacion {
  id          String    @id @default(cuid())
  recorridoId String
  recorrido   Recorrido @relation(fields: [recorridoId], references: [id], onDelete: Cascade)
  url         String
  alt         String
  orden       Int       @default(0)
}

// ==========================================
// PREMIOS
// ==========================================

model Premios {
  id       String @id @default(cuid())
  eventoId String @unique
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  efectivoUrl    String? // imagen de tabla de premiación en efectivo
  ceremoniaHora  String?
  ceremoniaLugar String?

  condiciones CondicionPremio[]
}

model CondicionPremio {
  id        String  @id @default(cuid())
  premiosId String
  premios   Premios @relation(fields: [premiosId], references: [id], onDelete: Cascade)
  texto     String
  orden     Int     @default(0)
}

// ==========================================
// REGLAMENTO
// ==========================================

model Reglamento {
  id       String @id @default(cuid())
  eventoId String @unique
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  competencia ReglaCompetencia[]
  seguridad   NormaSeguridad[]
  controles   ControlItem[]
}

model ReglaCompetencia {
  id           String     @id @default(cuid())
  reglamentoId String
  reglamento   Reglamento @relation(fields: [reglamentoId], references: [id], onDelete: Cascade)
  texto        String
  orden        Int        @default(0)
}

model NormaSeguridad {
  id           String     @id @default(cuid())
  reglamentoId String
  reglamento   Reglamento @relation(fields: [reglamentoId], references: [id], onDelete: Cascade)
  texto        String
  orden        Int        @default(0)
}

model ControlItem {
  id           String     @id @default(cuid())
  reglamentoId String
  reglamento   Reglamento @relation(fields: [reglamentoId], references: [id], onDelete: Cascade)
  texto        String
  orden        Int        @default(0)
}

// ==========================================
// LOGÍSTICA
// ==========================================

model Logistica {
  id       String @id @default(cuid())
  eventoId String @unique
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  servicios       ServicioItem[]
  recomendaciones RecomendacionItem[]
  kit             KitItem[]
}

model ServicioItem {
  id          String    @id @default(cuid())
  logisticaId String
  logistica   Logistica @relation(fields: [logisticaId], references: [id], onDelete: Cascade)
  texto       String
  orden       Int       @default(0)
}

model RecomendacionItem {
  id          String    @id @default(cuid())
  logisticaId String
  logistica   Logistica @relation(fields: [logisticaId], references: [id], onDelete: Cascade)
  texto       String
  orden       Int       @default(0)
}

model KitItem {
  id          String    @id @default(cuid())
  logisticaId String
  logistica   Logistica @relation(fields: [logisticaId], references: [id], onDelete: Cascade)
  texto       String
  orden       Int       @default(0)
}

// ==========================================
// NOTICIAS, OBJETIVOS, CONVOCATORIA, COSTOS
// ==========================================

model Noticia {
  id        String   @id @default(cuid())
  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  titulo    String
  fecha     String // texto libre, ej: "15 de enero, 2026"
  contenido String   @db.Text
  orden     Int      @default(0)
  createdAt DateTime @default(now())
}

model Objetivo {
  id       String @id @default(cuid())
  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  texto    String
  orden    Int    @default(0)
}

model ConvocatoriaItem {
  id       String @id @default(cuid())
  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  texto    String
  orden    Int    @default(0)
}

model Costo {
  id       String @id @default(cuid())
  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  tipo     String // ej: "adultos", "ninos"
  valor    Int

  inscripciones Inscripcion[]
}

// ==========================================
// INSCRIPCIONES (reemplaza WooCommerce + Google Sheets)
// ==========================================

model Inscripcion {
  id            String            @id @default(cuid())
  eventoId      String
  evento        Evento            @relation(fields: [eventoId], references: [id])
  // Opcional: eventos sin categorías (ej. carreras que solo usan `Costo`,
  // como "adultos"/"ninos") no tienen una Categoria a la que enlazar.
  categoriaId   String?
  categoria     Categoria?        @relation(fields: [categoriaId], references: [id])
  // Alternativa a categoria+pruebas para eventos que cobran por tipo de
  // costo (ej. "adultos"/"ninos") en vez de por categoría de competencia.
  costoId       String?
  costo         Costo?            @relation(fields: [costoId], references: [id])
  // Ronda cuyo precio se cobró (trazabilidad; el monto queda en totalPago).
  rondaId       String?
  ronda         RondaInscripcion? @relation(fields: [rondaId], references: [id], onDelete: SetNull)
  // Grupo de tarifa elegido directamente (eventos sin categorías); en
  // eventos con categorías se deriva de la categoría.
  grupoTarifaId String?
  grupoTarifa   GrupoTarifa?      @relation(fields: [grupoTarifaId], references: [id], onDelete: SetNull)

  // Atleta
  nombres         String
  apellidos       String
  tipoDocumento   TipoDocumento
  numeroDocumento String
  fechaNacimiento DateTime
  edad            Int
  genero          Genero

  // Pruebas seleccionadas (máx. 2) — se guardan como keys de PruebaCatalogo
  pruebasIds String[]

  // Contacto
  celular      String
  email        String
  ciudad       String
  departamento String
  club         String?

  // Adicional
  condicionesMedicas String?

  // Acudiente (si es menor de edad)
  nombresAcudiente   String?
  apellidosAcudiente String?
  documentoAcudiente String?
  celularAcudiente   String?

  // Legal
  aceptaTerminos      Boolean   @default(false)
  aceptaImagenes      Boolean   @default(false)
  // Trazabilidad legal (Fase 4): qué versión de TerminosBase estaba vigente
  // cuando el atleta aceptó, y en qué momento — nunca se sobrescribe si el
  // texto cambia después. Se calculan en servidor al crear la inscripción,
  // nunca se reciben del cliente.
  terminosVersion     Int?
  terminosAceptadosEn DateTime?

  // Pago
  totalPago          Int
  estadoPago         EstadoPago @default(PENDIENTE)
  wompiTransactionId String?
  wompiReference     String?    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventoId])
  @@index([numeroDocumento])
  @@index([estadoPago])
}

// ==========================================
// RATE LIMITING (Fase 4 — endpoint de inscripciones; Fase 10 — /atletas)
// ==========================================

// `contexto` separa el cupo de intentos por flujo (ej. "inscripcion" vs
// "atletas"): sin esto, alguien reintentando un pago y luego consultando
// sus inscripciones compartiría el mismo límite de 5 intentos/10min,
// bloqueándose entre sí sin motivo.
model IntentoInscripcion {
  id        String   @id @default(cuid())
  ip        String
  contexto  String   @default("inscripcion")
  createdAt DateTime @default(now())

  @@index([ip, contexto, createdAt])
}

// ==========================================
// TÉRMINOS Y CONDICIONES (Fase 4)
// ==========================================

// Bloque institucional del modal de Términos y Condiciones, igual para
// todos los eventos (las secciones que sí varían por evento — kit,
// premiación en efectivo — se arman en el modal a partir de datos que ya
// existen en Logistica/Premios, no se duplican acá). Nunca se edita una
// fila existente: cada cambio desde el admin crea una versión nueva
// (`version` autoincremental, `vigenteDesde` = momento del cambio), para
// que Inscripcion.terminosVersion siga apuntando a un texto inmutable
// aunque el club actualice el contenido después.
model TerminosBase {
  id           String   @id @default(cuid())
  version      Int      @unique
  contenido    String
  vigenteDesde DateTime @default(now())
}

// ==========================================
// DOCUMENTOS LEGALES (Fase 9 — Transparencia)
// ==========================================

// Reemplaza la lista hardcodeada de reglamento-legal-section.html: cada
// documento es un enlace externo (Google Drive) editable desde el admin,
// porque se actualizan una vez al año (renta, estados financieros, acta de
// asamblea) y no deberían requerir un despliegue nuevo cada vez.
model DocumentoLegal {
  id        String   @id @default(cuid())
  nombre    String
  url       String   @unique
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// CIFRAS DE CONFIANZA (Fase 9 — Home)
// ==========================================

// Franja de números grandes en la home ("45+ años de historia", etc.).
// `valor` es texto libre (no Int) a propósito: permite "45+", "5.000+",
// evitando reformatear un número en el componente.
model CifraConfianza {
  id        String   @id @default(cuid())
  etiqueta  String   @unique
  valor     String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// TESTIMONIOS (Fase 9 — Home)
// ==========================================

// `nombre`/`rol` son opcionales a propósito: los primeros testimonios
// reales son anónimos (autorizada la foto, no un nombre público) — el
// componente público solo muestra lo que tenga valor.
model Testimonio {
  id        String   @id @default(cuid())
  nombre    String?
  rol       String?
  cita      String   @unique
  fotoUrl   String?
  destacado Boolean  @default(false)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// SOCIOS / RESPALDO INSTITUCIONAL (Fase 9 — Home)
// ==========================================

// Reemplaza la lista de texto derivada de Evento.aval: logos reales de
// entidades y empresas que respaldan al club, editables desde el admin
// (los patrocinadores cambian de un año a otro).
model Socio {
  id        String   @id @default(cuid())
  nombre    String
  logoUrl   String   @unique
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// HITOS HISTÓRICOS / LÍNEA DE TIEMPO (Fase 9 — Home)
// ==========================================

// Recorrido cronológico por la historia del club, sección "Nuestra
// historia" de la home. `anio` es opcional porque no todos los hitos
// entregados por el club traen una fecha exacta (ej. la Personería
// Jurídica) — se muestra igual, ordenado por `orden`. `titulo` es
// `@unique` para poder sembrar con `upsert` sin pisar ediciones del
// admin, mismo criterio que Testimonio/Socio/CifraConfianza.
model HitoHistorico {
  id          String   @id @default(cuid())
  anio        Int?
  titulo      String   @unique
  descripcion String
  imagenUrl   String?
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
